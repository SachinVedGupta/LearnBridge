# Public website origin, HTTPS in production.
APP_URL=http://127.0.0.1:3200
# Supabase project settings. Publishable key only; never use a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
OPENAI_REQUESTS_ENABLED=false
COMPOSIO_API_KEY=
# Enable only AFTER configuring the project's public HTTPS callback verifier URL:
# https://your-domain/api/connectors/callback
COMPOSIO_CALLBACK_VERIFIER_ENABLED=false
# Auth config IDs from LearnBridge's dedicated Composio project.
COMPOSIO_AUTH_GMAIL=
COMPOSIO_AUTH_GOOGLECALENDAR=
COMPOSIO_AUTH_GOOGLETASKS=
COMPOSIO_AUTH_GOOGLEDRIVE=
COMPOSIO_AUTH_GOOGLEDOCS=
COMPOSIO_AUTH_GOOGLESHEETS=
COMPOSIO_AUTH_GOOGLESLIDES=
COMPOSIO_AUTH_NOTION=
COMPOSIO_AUTH_MICROSOFT_TEAMS=
COMPOSIO_AUTH_ONE_DRIVE=
COMPOSIO_AUTH_EXCEL=
COMPOSIO_AUTH_DISCORD=
COMPOSIO_AUTH_GITHUB=
COMPOSIO_AUTH_LINEAR=
COMPOSIO_AUTH_SLACK=
